{
  "name": "clawd-zk-primitives",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for @clawd/zk-client and @clawd/zk-shark-agent",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm --filter @clawd/zk-client run build && pnpm --filter @clawd/zk-shark-agent run build",
    "build:client": "pnpm --filter @clawd/zk-client run build",
    "test": "pnpm run build:client && pnpm --filter @clawd/zk-client test && pnpm --filter @clawd/zk-shark-agent test",
    "test:client": "pnpm --filter @clawd/zk-client test",
    "test:agent": "pnpm run build:client && pnpm --filter @clawd/zk-shark-agent test",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20"
  }
}
