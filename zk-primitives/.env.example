# Clawd ZK primitives — environment template
# Copy to agent/.env.local or export in your shell. Never commit real values.

# Preferred ZK Shark env names (legacy CLAWD_ZK_* still accepted by the agent).
ZK_SHARK_RPC_URL=https://api.mainnet-beta.solana.com
# ZK_SHARK_PHOTON_URL=
# ZK_SHARK_API_KEY=
ZK_SHARK_PROGRAM_ID=CLAWDzk11111111111111111111111111111111111
ZK_SHARK_COMMITMENT=confirmed
ZK_SHARK_NETWORK=devnet
# Path to a Solana CLI keypair JSON used only for delegated sign-and-send.
# ZK_SHARK_KEYPAIR=

# Legacy aliases (optional)
# CLAWD_ZK_RPC_URL=
# CLAWD_ZK_PHOTON_URL=
# CLAWD_ZK_API_KEY=
# CLAWD_ZK_PROGRAM_ID=
# CLAWD_ZK_COMMITMENT=
# CLAWD_ZK_NETWORK=
# CLAWD_ZK_KEYPAIR=

# Catalog root overrides (optional)
# CLAWDBOT_ZK_PRIMITIVES_DIR=./zk-primitives
# CLAWDBOT_SKILLS_DIR=
# CLAWDBOT_AGENTS_DIR=
