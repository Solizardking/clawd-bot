{
  "mcpServers": {
    "vulcan": {
      "command": "vulcan",
      "args": ["mcp"]
    },
    "robinhood-trading": {
      "type": "http",
      "url": "https://agent.robinhood.com/mcp/trading"
    },
    "clawd": {
      "command": "node",
      "args": ["zero-service/src/mcp-clawd.mjs"],
      "env": {
        "CLAWDBROWSER_ROOT": "."
      }
    },
    "clawd-soltrader": {
      "command": "node",
      "args": ["zero-service/src/mcp-soltrader.mjs"],
      "env": {
        "CLAWDBROWSER_ROOT": "."
      }
    }
  }
}
