# ── PumpFun copy bot + grok-4.6 ──────────────────────────────────────────
# Copy to .env next to the Rust binary.

# Yellowstone
YELLOWSTONE_GRPC_HTTP=
YELLOWSTONE_GRPC_TOKEN=
RPC_HTTP=https://api.mainnet-beta.solana.com
PRIVATE_KEY=

# Copy trading
COPY_TRADING_TARGET_ADDRESS=
IS_MULTI_COPY_TRADING=false
PROTOCOL_PREFERENCE=auto
SLIPPAGE=5000
TRANSACTION_LANDING_SERVICE=zeroslot

# ── xAI Grok (grok-4.6 Responses API) ─────────────────────────────────────
# User-facing / analyze paths use service_tier=priority (premium token rate
# only when the response echoes "priority"). Background jobs should omit it.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_TIMEOUT_MS=15000

# Optional Go sidecar (priority chat, compaction, X search, code interpreter,
# image generation, remote MCP). Start with: go run ./cmd/pump-grok
PUMP_GROK_URL=http://127.0.0.1:8788
PUMP_GROK_ADDR=127.0.0.1:8788
XAI_MCP_URL=
XAI_MCP_LABEL=clawd

# If true, wait for a Grok verdict before scheduling the sell. Fail-open on
# timeout/error. Default false so snipes stay on the Rust hot path.
GROK_GATE_SELLS=false
