{
  "name": "clawdbot-install",
  "version": "1.0.0",
  "description": "One-shot installer for ClawdBot Go — curl/npm wrapper over install.onchainai.fund and the clawdbot-go install.sh surface",
  "type": "module",
  "license": "MIT",
  "author": "Clawd / Solizardking",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solizardking/clawdbot-go.git",
    "directory": "packages/clawdbot-install"
  },
  "homepage": "https://github.com/Solizardking/clawdbot-go#readme",
  "bugs": {
    "url": "https://github.com/Solizardking/clawdbot-go/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "clawdbot",
    "clawd",
    "solana",
    "one-shot",
    "installer",
    "x402",
    "zk",
    "ooda",
    "install.onchainai.fund"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "clawdbot-install": "bin/clawdbot-install.js",
    "install-clawdbot": "bin/clawdbot-install.js"
  },
  "exports": {
    ".": "./lib/install.mjs",
    "./plan": "./lib/plan.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/clawdbot-install.js",
    "dry-run": "node bin/clawdbot-install.js --dry-run",
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "preferGlobal": true
}
