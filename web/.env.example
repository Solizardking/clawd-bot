# ClawdBot Web Console — environment template
# Copy to .env (gitignored). Never put real secrets in this file.

# Listen port for the Go backend (default 18800).
# PORT=18800

# Agent mode label shown in the dashboard (observer | paper | live).
AGENT_MODE=observer

# Optional CORS allow-list (comma-separated origins). Empty = restrictive default.
# CLAWDBOT_CORS_ORIGINS=http://localhost:5173

# Solana / market data (leave empty unless you need live connectors).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# HELIUS_RPC_URL=
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=
# JUPITER_API_KEY=
# ASTER_API_KEY=

# LLM provider keys (optional; used when the console drives model calls).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=

# x402 / zkrouter discovery (non-secret free tier id is the code default).
# ZKROUTER_API_KEY=
# ZKROUTER_BASE_URL=https://zk.x402.wtf

# Install / birth-funding admin (local operator only).
# CLAWDBOT_INSTALL_ADMIN_TOKEN=
# CLAWDBOT_INSTALL_LEDGER=
# CLAWDBOT_BIRTH_FUNDING_LEDGER=

# Catalog roots (optional overrides).
# CLAWDBOT_AGENTS_DIR=
# CLAWDBOT_SKILLS_DIR=
# CLAWDBOT_ZK_PRIMITIVES_DIR=./zk-primitives

# Vault file path override (keyvault package).
# CLAWDBOT_VAULT_FILE=
