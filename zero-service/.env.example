# ── SOL GPT zero-service ──────────────────────────────────────────────────
# Copy to .env (loaded by your process manager) or set in Render/host env.

# HTTP port for the SSE bridge.
PORT=8787

# Path to the compiled Zero binary. In Docker this is /usr/local/bin/zero.
# Locally: build with `cd ../zero-main && make build` then point here.
ZERO_BIN=../zero-main/zero

# Scratch workspace where the generated .zero/config.json + AGENTS.md live.
ZERO_WORKSPACE=/tmp/sol-gpt-workspace

# Model + provider. With XAI_API_KEY set, /chat uses the xAI Responses API
# (OpenAI SDK, baseURL https://api.x.ai/v1, model grok-4.6). Without it, Zero
# exec is used and auto-selects a provider from whichever *_API_KEY is set.
ZERO_MODEL=grok-4.6
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
# low | medium | high | xhigh — grok-4.6 defaults to high on the API; we use low for agentic latency.
XAI_REASONING_EFFORT=low
# Set true to store responses on xAI (30 days) and chain via previous_response_id.
XAI_STORE_RESPONSES=false
XAI_TIMEOUT_MS=3600000
# User-facing chat uses priority scheduling (billed only if response.service_tier is "priority").
XAI_SERVICE_TIER=priority
# Built-in xAI server tools (web, X, code interpreter, Imagine stills).
XAI_WEB_SEARCH=true
XAI_X_SEARCH=true
XAI_X_SEARCH_IMAGES=true
XAI_X_SEARCH_VIDEOS=true
XAI_CODE_EXECUTION=true
XAI_IMAGE_TOOL=true
XAI_VIDEO_TOOL=true
# Compact store:false tool loops every N turns (0 = off).
XAI_COMPACT_EVERY=6
XAI_IMAGE_MODEL=grok-imagine-image-quality
XAI_VIDEO_MODEL=grok-imagine-video-1.5
# Optional remote MCP:
# XAI_MCP=true
# XAI_MCP_URL=https://mcp.example.com/mcp
# XAI_MCP_LABEL=custom
# Optional override: OPENAI_API_KEY=
ZERO_MAX_TURNS=12

# Optional shared secret. If set, /chat requires `Authorization: Bearer <token>`.
# Must match ZERO_SERVICE_TOKEN in the Next.js app.
ZERO_SERVICE_TOKEN=

# ── Trading ───────────────────────────────────────────────────────────────
# Hard per-swap cap in input-token units (e.g. 0.5 = at most 0.5 SOL per trade).
MAX_SWAP_INPUT_AMOUNT=0.5

# Agent hot wallet (base58 secret key). WALLET_PRIVATE_KEY or AGENT_WALLET_PRIVATE_KEY.
WALLET_PRIVATE_KEY=

# Solana RPC (may embed an API key — never exposed to the model/UI).
RPC_URL=https://api.mainnet-beta.solana.com

# DFlow spot trading.
DFLOW_TRADE_API_URL=https://dev-quote-api.dflow.net
DFLOW_API_KEY=
DFLOW_SETTLEMENT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
DFLOW_PUBLIC_SPOT_SOL_FEE_ACCOUNT=
DFLOW_SPONSOR=
DFLOW_PRIORITY_FEE=auto

# ── Telegram trading bot ──────────────────────────────────────────────────
# Bot-first Privy wallets + DFlow /order. Starts with `npm start` when set.
TELEGRAM_BOT_TOKEN=
# Optional allowlist (comma-separated Telegram user IDs). Empty = any sender.
TELEGRAM_ALLOW_FROM=
TELEGRAM_CHAT_ID=
TELEGRAM_CLAIM_URL=http://127.0.0.1:18810/claim

# Privy (bot-first). Create an authorization key + Solana policy in the dashboard.
# Attach the signer to each Telegram user's embedded Solana wallet.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_SIGNER_ID=
PRIVY_POLICY_ID=
# PRIVY_BASE_URL=https://api.privy.io/v1

# Local Solana policy caps (Privy evaluates the same shape server-side).
POLICY_MAX_SOL_LAMPORTS=500000000
POLICY_MAX_USDC_AMOUNT=500000000
# Comma-separated extra program IDs (DEX venues DFlow may include).
# POLICY_EXTRA_PROGRAMS=

# ── Phoenix Perpetuals (Vulcan CLI) ───────────────────────────────────────
# Path to the vulcan binary (default: "vulcan", assumed on PATH).
# VULCAN_BIN=vulcan

# Stored wallet name. Vulcan manages encrypted keypairs locally.
# PERPS_WALLET=my-wallet
# VULCAN_WALLET_NAME=my-wallet
# VULCAN_WALLET_PASSWORD= (required for non-interactive MCP sessions)

# Phoenix API endpoint (default: https://perp-api.phoenix.trade).
# PERPS_API_URL=https://perp-api.phoenix.trade

# Solana RPC (shared with spot trading above if not set separately).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Risk limits (per-trade).
# PERPS_ALLOWED_SYMBOLS=SOL,ETH,BTC
# PERPS_MAX_NOTIONAL_USD=250
# PERPS_MAX_LEVERAGE=3
# PERPS_MAX_SPREAD_BPS=40

# Trading mode. All trading is PAPER by default. For live mode, set ALL three:
# LIVE_TRADING=true
# OPERATOR_CONFIRMED=true
# PERPS_SIM_ONLY=false
